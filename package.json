{
  "name": "kamino",
  "version": "0.1.0",
  "private": true,
  "description": "A non-commercial, fan-made single-player first-person browser game prototype inspired by the Battle of Kamino.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.client.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.client.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16"
  },
  "packageManager": "pnpm@11.25.0"
}
